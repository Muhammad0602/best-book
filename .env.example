# Copy this file to ".env.local" and fill in the two values from your Supabase
# project (Project Settings -> API). Without them the app still works, but
# highlights and drawings are only saved on the device.
#
# Use the "anon" / "publishable" key. Never put the service_role key here.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
